# Normalize line endings for all text files; diff/merge stays sane across
# contributor OSes (Godot's own default .gitattributes recommendation).
* text=auto eol=lf

# GDScript
*.gd text eol=lf diff=python

# Godot scene/resource/project files are text-based INI-like formats but
# are machine-edited (Inspector, scene tree) far more often than hand-edited
# — treat as text for diffability, but don't expect clean 3-way merges.
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
project.godot text eol=lf
export_presets.cfg text eol=lf

# Import metadata is regenerated by the editor; keep out of merge noise.
*.import -diff -merge

# Markdown / docs / config
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf

# Binary assets — never text-normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg -text
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.glb binary
*.gltf binary
*.blend binary
*.icns binary
*.ico binary
